APP_ENV=local
LOG_LEVEL=INFO
POSTGRES_DB=fiapx
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=fiapx
DATABASE_URL=postgresql+asyncpg://fiapx:fiapx@postgres:5432/fiapx
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://fiapx:fiapx@rabbitmq:5672/
RABBITMQ_USER=fiapx
RABBITMQ_PASSWORD=fiapx
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fiapx
MINIO_SECRET_KEY=fiapxsecret
MINIO_BUCKET=videos
MINIO_SECURE=false
MAX_UPLOAD_SIZE_BYTES=524288000
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
VIDEO_FRAME_INTERVAL_SECONDS=1
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_MAX_WIDTH=3840
VIDEO_MAX_HEIGHT=2160
DOWNLOAD_URL_EXPIRATION_SECONDS=300
VIDEO_PROCESSING_MAX_RETRIES=3
VIDEO_RETRY_BASE_DELAY_SECONDS=5
VIDEO_RETRY_MAX_DELAY_SECONDS=300
VIDEO_RETRY_JITTER_SECONDS=2
VIDEO_WORKER_PREFETCH=1
VIDEO_PROCESSING_LEASE_SECONDS=120
VIDEO_PROCESSING_LEASE_RENEW_SECONDS=30
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
FFMPEG_TIMEOUT_SECONDS=3600
FFPROBE_TIMEOUT_SECONDS=30
JWT_SECRET=generate-a-long-random-secret-for-this-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:4200
API_PORT=8000
FRONTEND_PORT=4200
